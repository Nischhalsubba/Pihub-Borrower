# demo (default) keeps all data in this browser and uses the Borrower demo account.
# api uses the shared PiHub backend with an HttpOnly server session.
VITE_PIHUB_RUNTIME=demo
VITE_PIHUB_API_BASE_URL=https://api.pihub-pi.com
# Optional, must accept privacy-scrubbed operational telemetry only.
VITE_PIHUB_TELEMETRY_URL=
